#include <stdio.h>
#include <stdlib.h> // 必须包含这个头文件，才能使用 system() 函数

int main()
{
    int a, b;

    // 第一段剧情
    printf("不不不，打不了字，我无疑是愤怒的！\n扣1帮助掌舵获得打字权利\n");
    scanf("%d", &a);

    if (a == 1)
    {
        printf("掌舵获得打字权利！\n");
        // 这里可以继续写 a==1 之后的后续剧情
    }
    else
    {
        // 玩家输入的不是 1 时的剧情
        printf("你根本不想帮助我获得打字权利！\nBOSS进入第二关\n");
        
        // 暂停一下，让玩家有时间看完上面这句话（按任意键继续）
        system("pause"); 
        
        // “删除整个页面”：清空屏幕上的所有文字
        system("cls"); 
        
        // 清屏后，输出新的剧情
        printf("扣1帮助掌舵获得使用小黑一级的权利\n");
        scanf("%d", &b);

        if (b == 2)
        {
            printf("掌舵获得使用小黑一级的权利！\n");
        }
        else
        {
            printf("你根本不想帮助我获得任何权利！\n");
        }
    }

    return 0;
}